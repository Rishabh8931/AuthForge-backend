{
  "name": "authforge",
  "version": "0.1.0",
  "description": "Production-grade OAuth 2.1 and OpenID Connect Authorization Server.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "",
  "keywords": [
    "oauth2",
    "oauth2.1",
    "openid-connect",
    "oidc",
    "authorization-server",
    "identity-provider",
    "authentication",
    "authorization",
    "jwt",
    "typescript",
    "nodejs"
  ],
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.21.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.9",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
